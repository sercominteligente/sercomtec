{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sercomtec",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sercomtec-db",
      "database_id": "5f539a20-744c-45c0-9a9c-62c9adccaf13"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "sercomtec-files"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna",
    "CF_ACCESS_TEAM_DOMAIN": "bitter-cell-31bf.cloudflareaccess.com",
    "CF_ACCESS_AUD": "83863914-4392-42cc-9877-2bd12b01ac0b"
  }
}
